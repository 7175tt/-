# Optional server-wide key; personal keys are entered in the app.
# Sharing the server key is disabled unless explicitly enabled below.
# Never prefix API keys with VITE_.
GEMINI_API_KEY=
ALLOW_SHARED_GEMINI_KEY=false
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Public OAuth client ID. Set authorized JavaScript origins in Google Cloud.
# Leaving this empty uses the existing project client ID.
VITE_GOOGLE_CLIENT_ID=

# Optional long-lived device sign-in. Server only; never use VITE_ for secrets.
# Use the client secret of the same web OAuth client configured above.
GOOGLE_OAUTH_CLIENT_SECRET=
# At least 32 random characters; keep the same secret across replicas/redeploys.
GOOGLE_SESSION_SECRET=
# Exact public origin, no trailing slash. Must match the web client's JS origin.
GOOGLE_AUTH_ORIGIN=https://business-card-keeper.ai.studio
