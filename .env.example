# Optional server-wide key; personal keys are entered in the app.
# Sharing the server key is disabled unless explicitly enabled below.
# Never prefix API keys with VITE_.
GEMINI_API_KEY=
ALLOW_SHARED_GEMINI_KEY=false
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Public OAuth web client ID; Vite reads this at build time.
